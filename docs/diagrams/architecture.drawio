        <mxCell id="pattern_pattern_57" value="7" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="536" width="36" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_58" value="&lt;b&gt;コマンドの実行&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="536" width="120" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_59" value="run_command" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="176" y="536" width="196" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_60" value="プログラムと引数を決める" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#E3EED8;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="372" y="536" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_61" value="許可したプログラムか判定する／&lt;b&gt;承認を待つ&lt;/b&gt;／シェルを介さずに起動する（環境変数を絞る）" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#DCE6F2;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="602" y="536" width="360" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_62" value="あり" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FBE3C8;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="962" y="536" width="80" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_63" value="外部と通信するツールを止める" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FDF3D3;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1042" y="536" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_64" value="C" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="1272" y="536" width="58" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_65" value="8" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F8FA;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="602" width="36" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_66" value="&lt;b&gt;GitHub&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F8FA;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="602" width="120" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_67" value="github_list・view・pr_diff&lt;br&gt;github_comment・create_pr" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F8FA;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="176" y="602" width="196" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_68" value="対象・送る本文を決める" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#E3EED8;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="372" y="602" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_69" value="gh の引数をアプリが組み立てる／コメント・PR の作成は&lt;b&gt;承認を待つ&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#DCE6F2;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="602" y="602" width="360" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_70" value="書くときだけ" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FBE3C8;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="962" y="602" width="80" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_71" value="読んだら外部と通信するツールを止める" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FDF3D3;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1042" y="602" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_72" value="B / C" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F8FA;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="1272" y="602" width="58" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_73" value="9" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="668" width="36" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_74" value="&lt;b&gt;ブラウザ&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="668" width="120" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_75" value="browser_navigate・snapshot・screenshot&lt;br&gt;browser_click・type・select" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="176" y="668" width="196" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_76" value="開く URL・操作する要素を決める（画面を読めるのは vision 対応のモデルだけ）" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#E3EED8;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="372" y="668" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_77" value="プロキシで接続ごとに宛先を判定する／クリック・入力・選択は&lt;b&gt;承認を待つ&lt;/b&gt;／利用者へ見せる画面を撮る（モデルには渡さない）" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#DCE6F2;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="602" y="668" width="360" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_78" value="操作するときだけ" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FBE3C8;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="962" y="668" width="80" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_79" value="手元の開発サーバーを開いたら外部と通信するツールを止める" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FDF3D3;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1042" y="668" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_80" value="B / C" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="1272" y="668" width="58" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_81" value="10" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F8FA;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="734" width="36" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_82" value="&lt;b&gt;タイトルの生成&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F8FA;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="734" width="120" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_83" value="—" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F8FA;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="176" y="734" width="196" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_84" value="短いタイトルを返す" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#E3EED8;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="372" y="734" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_85" value="ストリームせず 1 回で受け取る／出力のトークン数に上限を付ける（占有を防ぐ）" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#DCE6F2;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="602" y="734" width="360" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_86" value="—" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F8FA;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="962" y="734" width="80" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_87" value="—" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F8FA;strokeColor=#C9D1DC;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1042" y="734" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_88" value="A" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F8FA;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="1272" y="734" width="58" height="66" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_89" value="&lt;b&gt;Ollama は会話を覚えない&lt;/b&gt;&lt;br&gt;/api/chat は状態を持たない。アプリが毎回、役割・日時・履歴（MAX_HISTORY_MESSAGES まで）をまとめて送り直す。会話が続いているように見えるのは、PostgreSQL に保存した履歴をアプリが組み立てているから。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA5B8;" vertex="1" parent="1"><mxGeometry x="20" y="824" width="430" height="110" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_90" value="&lt;b&gt;tool_calls は「提案」でしかない&lt;/b&gt;&lt;br&gt;Ollama が返すのは「このツールをこの引数で呼びたい」という JSON だけ。実行するか・承認を挟むか・宛先を断るかはアプリが決める。モデルが指示を外れても、安全策はアプリの側で効く。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA5B8;" vertex="1" parent="1"><mxGeometry x="460" y="824" width="430" height="110" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_91" value="&lt;b&gt;「その後の応答への制約」の意味&lt;/b&gt;&lt;br&gt;ファイル・コマンド・GitHub・手元の開発サーバーの内容を読んだ後は、同じ応答の中で web_search・url_fetch 等を実行しない。読んだ内容を外部へ送らせないため。1 回のツールでは決まらず、応答の中の順序で効く。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA5B8;" vertex="1" parent="1"><mxGeometry x="900" y="824" width="430" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
