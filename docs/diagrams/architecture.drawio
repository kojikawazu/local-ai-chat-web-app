        <mxCell id="seqB_26" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#9C6E98;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="158" as="sourcePoint"/><mxPoint x="140" y="1094" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_27" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#5E81AC;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="158" as="sourcePoint"/><mxPoint x="390" y="1094" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_28" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#5E81AC;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="158" as="sourcePoint"/><mxPoint x="640" y="1094" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_29" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#B8743C;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="158" as="sourcePoint"/><mxPoint x="890" y="1094" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_30" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#7A9A5A;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="158" as="sourcePoint"/><mxPoint x="1140" y="1094" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_title" value='&lt;b style="font-size:20px"&gt;シーケンス B — ツールの往復・承認なし（パターン 3・4・5・8 の読み取り・9 の閲覧）&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;エージェントのループの骨格。Ollama はツールを「提案」し、アプリが判定して実行する&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="56" as="geometry"/></mxCell>
        <mxCell id="seqB_legend" value='&lt;b&gt;色の意味&lt;/b&gt;&lt;br&gt;&lt;span style="background:#E3EED8"&gt;&amp;nbsp;緑&amp;nbsp;&lt;/span&gt;: Ollama&lt;br&gt;&lt;span style="background:#EFE5F0"&gt;&amp;nbsp;紫&amp;nbsp;&lt;/span&gt;: ブラウザ（画面・useChat）&lt;br&gt;&lt;span style="background:#DCE6F2"&gt;&amp;nbsp;青&amp;nbsp;&lt;/span&gt;: Web アプリ（Next.js サーバー）&lt;br&gt;&lt;span style="background:#FBE3C8"&gt;&amp;nbsp;橙&amp;nbsp;&lt;/span&gt;: 利用者の承認が絡むこと' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA5B8;" vertex="1" parent="1"><mxGeometry x="1110" y="4" width="250" height="92" as="geometry"/></mxCell>
        <mxCell id="seqB_seqB_1" value="&lt;b&gt;ブラウザ&lt;br&gt;（useChat）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#EFE5F0;strokeColor=#9C6E98;" vertex="1" parent="1"><mxGeometry x="50" y="108" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="seqB_seqB_2" value="&lt;b&gt;/api/chat&lt;br&gt;Agent Loop&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#DCE6F2;strokeColor=#5E81AC;" vertex="1" parent="1"><mxGeometry x="300" y="108" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="seqB_seqB_3" value="&lt;b&gt;Tool Executor&lt;br&gt;（各ツール）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#DCE6F2;strokeColor=#5E81AC;" vertex="1" parent="1"><mxGeometry x="550" y="108" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="seqB_seqB_4" value="&lt;b&gt;SearXNG / ファイル&lt;br&gt;gh / Chromium&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#F7EFE8;strokeColor=#B8743C;" vertex="1" parent="1"><mxGeometry x="800" y="108" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="seqB_seqB_5" value="&lt;b&gt;Ollama&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#E3EED8;strokeColor=#7A9A5A;" vertex="1" parent="1"><mxGeometry x="1050" y="108" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="seqB_6" value="1. POST /api/chat（エージェントのモード）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="148" y="188" as="sourcePoint"/><mxPoint x="382" y="188" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_seqB_7" value="&lt;b&gt;2.&lt;/b&gt; 有効なツールの定義を集める&lt;br&gt;（環境変数で登録されたものだけ）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fontSize=11;fillColor=#DCE6F2;strokeColor=#5E81AC;" vertex="1" parent="1"><mxGeometry x="290.0" y="214" width="200" height="46" as="geometry"/></mxCell>
        <mxCell id="seqB_8" value="3. messages + tools の定義" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="398" y="306" as="sourcePoint"/><mxPoint x="1132" y="306" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_seqB_9" value="&lt;b&gt;4.&lt;/b&gt; 推論して、呼ぶツールと引数を決める" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fontSize=11;fillColor=#E3EED8;strokeColor=#7A9A5A;" vertex="1" parent="1"><mxGeometry x="1040.0" y="332" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="seqB_10" value="5. tool_calls（名前・引数の JSON。提案だけ）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1132" y="390" as="sourcePoint"/><mxPoint x="398" y="390" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_11" value="6. tool_call_start" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="382" y="430" as="sourcePoint"/><mxPoint x="148" y="430" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_seqB_12" value="&lt;b&gt;7.&lt;/b&gt; この応答の制約を確認&lt;br&gt;手元の情報を読んだ後なら&lt;br&gt;外部と通信するツールは実行せずに断る" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fontSize=11;fillColor=#DCE6F2;strokeColor=#5E81AC;" vertex="1" parent="1"><mxGeometry x="275.0" y="456" width="230" height="62" as="geometry"/></mxCell>
        <mxCell id="seqB_13" value="8. 実行（30 秒で打ち切り・停止を伝える）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="398" y="546" as="sourcePoint"/><mxPoint x="632" y="546" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_seqB_14" value="&lt;b&gt;9.&lt;/b&gt; 引数を検証&lt;br&gt;許可したフォルダ・リポジトリか&lt;br&gt;プライベートのアドレスでないか" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fontSize=11;fillColor=#DCE6F2;strokeColor=#5E81AC;" vertex="1" parent="1"><mxGeometry x="525.0" y="572" width="230" height="62" as="geometry"/></mxCell>
        <mxCell id="seqB_15" value="10. 検索する／ファイルを読む／gh を起動／ページを開く" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="662" as="sourcePoint"/><mxPoint x="882" y="662" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_16" value="11. 結果" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="882" y="702" as="sourcePoint"/><mxPoint x="648" y="702" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_17" value="12. ツールの結果" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="742" as="sourcePoint"/><mxPoint x="398" y="742" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_18" value="13. tool_call_result" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="382" y="782" as="sourcePoint"/><mxPoint x="148" y="782" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_seqB_19" value="&lt;b&gt;14.&lt;/b&gt; 結果を role: tool として messages に足す&lt;br&gt;手元を読むツールが成功したら印を付ける" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fontSize=11;fillColor=#DCE6F2;strokeColor=#5E81AC;" vertex="1" parent="1"><mxGeometry x="265.0" y="808" width="250" height="46" as="geometry"/></mxCell>
        <mxCell id="seqB_seqB_20" value="&lt;b&gt;loop&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=22;fontSize=11;fillColor=none;strokeColor=#5E6B80;" vertex="1" parent="1"><mxGeometry x="25" y="262" width="1230" height="598" as="geometry"/></mxCell>
        <mxCell id="seqB_seqB_21" value="[最大 10 ラウンド・tool_calls がある間]" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#3B4252;" vertex="1" parent="1"><mxGeometry x="91" y="262" width="400" height="22" as="geometry"/></mxCell>
        <mxCell id="seqB_22" value="15. messages（ツールの結果を含む）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="398" y="892" as="sourcePoint"/><mxPoint x="1132" y="892" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_23" value="16. 最終の回答（tool_calls なし）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1132" y="932" as="sourcePoint"/><mxPoint x="398" y="932" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_24" value="17. text_delta … done" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="382" y="972" as="sourcePoint"/><mxPoint x="148" y="972" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqB_seqB_25" value="&lt;b&gt;10 ラウンドに達したら&lt;/b&gt;&lt;br&gt;ツールを外して呼び、ここまでの結果で&lt;br&gt;回答させる（上限に達した旨を先頭に付ける）" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=10;fillColor=#FFF9E6;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="410" y="1000" width="250" height="64" as="geometry"/></mxCell>
      </root>
