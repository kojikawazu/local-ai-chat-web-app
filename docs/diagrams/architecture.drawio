        <mxCell id="seqC_seqC_6" value="&lt;b&gt;Ollama&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#E3EED8;strokeColor=#7A9A5A;" vertex="1" parent="1"><mxGeometry x="1300" y="108" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="seqC_7" value="1. messages + tools の定義" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="188" as="sourcePoint"/><mxPoint x="1382" y="188" as="targetPoint"/></mxGeometry></mxCell>
