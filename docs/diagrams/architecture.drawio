        <mxCell id="seqA_9" value="4. INSERT Message / Attachment" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="340" as="sourcePoint"/><mxPoint x="882" y="340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_10" value="5. POST /api/chat（履歴・model・systemPrompt・imageIds）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="398" y="380" as="sourcePoint"/><mxPoint x="632" y="380" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_seqA_11" value="&lt;b&gt;6.&lt;/b&gt; 入力を検証&lt;br&gt;役割 + 現在の日時を先頭の system に&lt;br&gt;履歴を上限（MAX_HISTORY_MESSAGES）で切る" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fontSize=11;fillColor=#DCE6F2;strokeColor=#5E81AC;" vertex="1" parent="1"><mxGeometry x="525.0" y="406" width="230" height="62" as="geometry"/></mxCell>
        <mxCell id="seqA_12" value="7. 添付画像を ID で読む" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="496" as="sourcePoint"/><mxPoint x="882" y="496" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_13" value="8. POST /api/chat（stream: true・messages・images）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="536" as="sourcePoint"/><mxPoint x="1132" y="536" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_seqA_14" value="&lt;b&gt;9.&lt;/b&gt; モデルで推論する&lt;br&gt;（渡された履歴を毎回すべて読む）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fontSize=11;fillColor=#E3EED8;strokeColor=#7A9A5A;" vertex="1" parent="1"><mxGeometry x="1040.0" y="562" width="200" height="46" as="geometry"/></mxCell>
        <mxCell id="seqA_15" value="10. 本文・思考の断片（NDJSON）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1132" y="654" as="sourcePoint"/><mxPoint x="648" y="654" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_16" value="11. text_delta / thinking を中継" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="694" as="sourcePoint"/><mxPoint x="398" y="694" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_seqA_17" value="&lt;b&gt;loop&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=22;fontSize=11;fillColor=none;strokeColor=#5E6B80;" vertex="1" parent="1"><mxGeometry x="275" y="610" width="980" height="102" as="geometry"/></mxCell>
        <mxCell id="seqA_seqA_18" value="[生成が終わるまで]" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#3B4252;" vertex="1" parent="1"><mxGeometry x="341" y="610" width="400" height="22" as="geometry"/></mxCell>
        <mxCell id="seqA_19" value="12. done（eval_count・eval_duration）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1132" y="744" as="sourcePoint"/><mxPoint x="648" y="744" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_20" value="13. done（トークン数・所要時間）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="784" as="sourcePoint"/><mxPoint x="398" y="784" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_21" value="14. POST /api/conversations/[id]/messages（assistant を保存）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="398" y="824" as="sourcePoint"/><mxPoint x="632" y="824" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_22" value="15. INSERT Message" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="864" as="sourcePoint"/><mxPoint x="882" y="864" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_23" value="16. POST /api/conversations/[id]/generate-title" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="398" y="922" as="sourcePoint"/><mxPoint x="632" y="922" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_24" value="17. POST /api/chat（stream: false・トークン数に上限）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="962" as="sourcePoint"/><mxPoint x="1132" y="962" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_25" value="18. 短いタイトル" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1132" y="1002" as="sourcePoint"/><mxPoint x="648" y="1002" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_26" value="19. UPDATE Conversation.title" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="1042" as="sourcePoint"/><mxPoint x="882" y="1042" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_seqA_27" value="&lt;b&gt;opt&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=60;height=22;fontSize=11;fillColor=none;strokeColor=#5E6B80;" vertex="1" parent="1"><mxGeometry x="275" y="878" width="980" height="182" as="geometry"/></mxCell>
        <mxCell id="seqA_seqA_28" value="[会話の最初のやり取りのとき]" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#3B4252;" vertex="1" parent="1"><mxGeometry x="341" y="878" width="400" height="22" as="geometry"/></mxCell>
        <mxCell id="seqA_seqA_29" value="&lt;b&gt;Ollama は会話を覚えない&lt;/b&gt;&lt;br&gt;毎回、アプリが履歴をまとめて送り直す。&lt;br&gt;停止・切断はアプリが fetch の signal で伝える" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=10;fillColor=#FFF9E6;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="860" y="1080" width="260" height="64" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="seqB" name="4. シーケンス B ツールの往復">
    <mxGraphModel dx="1400" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0">
      <root>
