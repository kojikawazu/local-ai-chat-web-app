        <mxCell id="seqA_6" value="1. メッセージを送る（画像を添付してもよい）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="148" y="188" as="sourcePoint"/><mxPoint x="382" y="188" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqA_7" value="2. POST /api/conversations/[id]/messages&lt;br&gt;user のメッセージ・画像を保存" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="398" y="228" as="sourcePoint"/><mxPoint x="632" y="228" as="targetPoint"/></mxGeometry></mxCell>
