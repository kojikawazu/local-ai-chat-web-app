        <mxCell id="seqC_35" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#7A9A5A;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1390" y="158" as="sourcePoint"/><mxPoint x="1390" y="1114" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqC_title" value='&lt;b style="font-size:20px"&gt;シーケンス C — 承認を挟む往復（パターン 6・7・8 の書き込み・9 の操作）&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;ファイルの書き込み・コマンドの実行・GitHub への投稿・ブラウザの操作。準備 → 承認 → 実行 の 3 段&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="56" as="geometry"/></mxCell>
        <mxCell id="seqC_legend" value='&lt;b&gt;色の意味&lt;/b&gt;&lt;br&gt;&lt;span style="background:#E3EED8"&gt;&amp;nbsp;緑&amp;nbsp;&lt;/span&gt;: Ollama&lt;br&gt;&lt;span style="background:#EFE5F0"&gt;&amp;nbsp;紫&amp;nbsp;&lt;/span&gt;: ブラウザ（画面・useChat）&lt;br&gt;&lt;span style="background:#DCE6F2"&gt;&amp;nbsp;青&amp;nbsp;&lt;/span&gt;: Web アプリ（Next.js サーバー）&lt;br&gt;&lt;span style="background:#FBE3C8"&gt;&amp;nbsp;橙&amp;nbsp;&lt;/span&gt;: 利用者の承認が絡むこと' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA5B8;" vertex="1" parent="1"><mxGeometry x="1500" y="4" width="250" height="92" as="geometry"/></mxCell>
        <mxCell id="seqC_seqC_1" value="&lt;b&gt;利用者&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#FFFFFF;strokeColor=#4C566A;" vertex="1" parent="1"><mxGeometry x="50" y="108" width="180" height="50" as="geometry"/></mxCell>
