        <mxCell id="pattern_pattern_50" value="&lt;b&gt;ファイルの書き込み&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F8FA;strokeColor=#C9D1DC;align=center;" vertex="1" parent="1"><mxGeometry x="56" y="470" width="120" height="66" as="geometry"/></mxCell>
