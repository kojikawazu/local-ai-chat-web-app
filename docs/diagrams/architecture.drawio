  <diagram id="pattern" name="2. Ollama とアプリの責務（パターン表）">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="pattern_title" value='&lt;b style="font-size:20px"&gt;Ollama とアプリの責務の分担 — パターン表&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Ollama は「推論して、次に何をするかを提案する」だけ。実行・判定・保存・安全策はすべてアプリが持つ&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="56" as="geometry"/></mxCell>
        <mxCell id="pattern_legend" value='&lt;b&gt;色の意味&lt;/b&gt;&lt;br&gt;&lt;span style="background:#E3EED8"&gt;&amp;nbsp;緑&amp;nbsp;&lt;/span&gt;: Ollama&lt;br&gt;&lt;span style="background:#DCE6F2"&gt;&amp;nbsp;青&amp;nbsp;&lt;/span&gt;: アプリ（Next.js）がすること&lt;br&gt;&lt;span style="background:#FBE3C8"&gt;&amp;nbsp;橙&amp;nbsp;&lt;/span&gt;: 利用者の承認が絡むこと' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA5B8;" vertex="1" parent="1"><mxGeometry x="1110" y="8" width="250" height="76" as="geometry"/></mxCell>
        <mxCell id="pattern_pattern_1" value="&lt;b&gt;#&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#4C566A;strokeColor=#4C566A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="36" height="40" as="geometry"/></mxCell>
