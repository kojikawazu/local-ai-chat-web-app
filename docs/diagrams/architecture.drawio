        <mxCell id="seqC_9" value="3. 準備（prepare）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="268" as="sourcePoint"/><mxPoint x="1132" y="268" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqC_seqC_10" value="&lt;b&gt;4.&lt;/b&gt; 書いてよい場所か判定&lt;br&gt;差分を作る（まだ書かない）&lt;br&gt;ブラウザなら操作の前の画面を撮る" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fontSize=11;fillColor=#DCE6F2;strokeColor=#5E81AC;" vertex="1" parent="1"><mxGeometry x="1025.0" y="294" width="230" height="62" as="geometry"/></mxCell>
        <mxCell id="seqC_11" value="5. プレビュー（差分・コマンド・本文・要素）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1132" y="384" as="sourcePoint"/><mxPoint x="648" y="384" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqC_12" value="6. 承認待ちを登録（approvalId・最大 5 分）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="424" as="sourcePoint"/><mxPoint x="882" y="424" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqC_13" value="7. tool_approval_request（プレビュー・残り時間）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="464" as="sourcePoint"/><mxPoint x="398" y="464" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqC_14" value="8. 承認カードを表示（Markdown として描かない）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="382" y="504" as="sourcePoint"/><mxPoint x="148" y="504" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqC_15" value="9. 許可 / 拒否" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="148" y="544" as="sourcePoint"/><mxPoint x="382" y="544" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqC_16" value="10. POST /api/agent/approvals/[id]（approved）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="398" y="584" as="sourcePoint"/><mxPoint x="882" y="584" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqC_17" value="11. 決着を知らせる" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="882" y="624" as="sourcePoint"/><mxPoint x="648" y="624" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqC_18" value="12. 実行（run）" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=block;endFill=1;strokeColor=#2E3440;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="682" as="sourcePoint"/><mxPoint x="1132" y="682" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seqC_seqC_19" value="&lt;b&gt;13.&lt;/b&gt; 準備で作った中身を書く&lt;br&gt;承認の間に変わっていれば書かない" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fontSize=11;fillColor=#DCE6F2;strokeColor=#5E81AC;" vertex="1" parent="1"><mxGeometry x="1025.0" y="708" width="230" height="46" as="geometry"/></mxCell>
        <mxCell id="seqC_20" value="14. 結果" style="html=1;verticalAlign=bottom;fontSize=11;endArrow=open;endFill=0;dashed=1;strokeColor=#4C566A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1132" y="782" as="sourcePoint"/><mxPoint x="648" y="782" as="targetPoint"/></mxGeometry></mxCell>
