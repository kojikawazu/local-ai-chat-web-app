        <mxCell id="seqC_seqC_4" value="&lt;b&gt;approvals.ts&lt;br&gt;（承認待ち）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#FBE3C8;strokeColor=#D08770;" vertex="1" parent="1"><mxGeometry x="800" y="108" width="180" height="50" as="geometry"/></mxCell>
