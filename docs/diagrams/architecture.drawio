        <mxCell id="seqA_title" value='&lt;b style="font-size:20px"&gt;シーケンス A — 基本の往復（パターン 1・2・10）&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;通常のチャット・画像の添付・タイトルの生成。ツールは使わない&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="56" as="geometry"/></mxCell>
        <mxCell id="seqA_legend" value='&lt;b&gt;色の意味&lt;/b&gt;&lt;br&gt;&lt;span style="background:#E3EED8"&gt;&amp;nbsp;緑&amp;nbsp;&lt;/span&gt;: Ollama&lt;br&gt;&lt;span style="background:#EFE5F0"&gt;&amp;nbsp;紫&amp;nbsp;&lt;/span&gt;: ブラウザ（画面・useChat）&lt;br&gt;&lt;span style="background:#DCE6F2"&gt;&amp;nbsp;青&amp;nbsp;&lt;/span&gt;: Web アプリ（Next.js サーバー）&lt;br&gt;&lt;span style="background:#FBE3C8"&gt;&amp;nbsp;橙&amp;nbsp;&lt;/span&gt;: 利用者の承認が絡むこと' style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA5B8;" vertex="1" parent="1"><mxGeometry x="1110" y="4" width="250" height="92" as="geometry"/></mxCell>
