# このファイルを .env.local にコピーして使用します:  cp .env.example .env.local

# Ollama API 接続先
OLLAMA_BASE_URL=http://localhost:11434

# 使用モデル（実際に `ollama pull` したモデル名に合わせること）
# アプリのデフォルトは大型モデル。低スペック機では軽量モデル（例: gemma3:4b）を指定する
OLLAMA_MODEL=qwen3.8:27b

# PostgreSQL 接続文字列（docker-compose.yml と一致させる。ポート 5499）
DATABASE_URL=postgresql://postgres:postgres@localhost:5499/chat_db

# --- エージェント機能（任意。未設定時は下記デフォルトが使われる） ---
# エージェントループの最大ツール呼び出しラウンド数（1〜50 の整数。範囲外・不正な値は既定値 10 に戻る）
AGENT_MAX_TOOL_ROUNDS=10
# ツール実行タイムアウト（ミリ秒。1〜300000 の整数。範囲外・不正な値は既定値 30000 に戻る）
AGENT_TOOL_TIMEOUT_MS=30000
# Web検索ツール（web_search）が問い合わせる SearXNG の接続先（docker-compose.yml の searxng サービス。ポート 8888）
SEARXNG_URL=http://localhost:8888

# --- 図の描画（任意。未設定時は下記デフォルトが使われる） ---
# PlantUML の図を描く PlantUML サーバーの接続先（docker-compose.yml の plantuml サービス。ポート 8889）
PLANTUML_URL=http://localhost:8889

# --- ローカルのファイルのツール（任意。未設定ならツールを使わない。#148） ---
# エージェントがファイルの一覧・検索・読み取りをしてよいフォルダの絶対パス（カンマ区切り。~ はホーム）。
# プロジェクトのフォルダなど、必要な範囲だけを指定する（ホーム全体は指定しない）。.env・鍵ファイル・.ssh などは指定しても読ませない
# LOCAL_FILE_ROOTS=~/developer/my-project,~/notes
# エージェントがファイルを作成・編集してよいフォルダ（LOCAL_FILE_ROOTS の中だけ。未設定なら書き込みのツールを使わない。#148 Phase A2）。
# 書き込みのたびに差分を見せて承認を求める。作業中のリポジトリなど、Git で戻せる範囲だけを指定する
# LOCAL_FILE_WRITE_ROOTS=~/developer/my-project
# エージェントが実行してよいプログラムの名前（カンマ区切り。未設定ならコマンドの実行のツールを使わない。#148 Phase B）。
# 作業フォルダは LOCAL_FILE_WRITE_ROOTS の中だけ。実行のたびにコマンドを見せて承認を求める。
# 書いたプログラムは何でも実行できる前提で選ぶ（node・pnpm は任意のコードを実行できる。curl など外へ送るものは書かない）。
# シェル（bash 等）と env・sudo・xargs などは書いても使わない
# LOCAL_COMMANDS=git,pnpm
# コマンドの実行時間の上限（ミリ秒。既定 120000、上限 600000）
# LOCAL_COMMAND_TIMEOUT_MS=120000
# エージェントの GitHub のツールで扱ってよいリポジトリ（owner/name のカンマ区切り。未設定なら GitHub のツールを使わない。#148 Phase C）。
# PR・issue を読むツールは承認なし、コメント・PR の作成は送る本文を見せて承認を求める。gh（GitHub CLI）を入れて gh auth login でログインしておく。
# トークンはここに書かない。gh を LOCAL_COMMANDS に書く必要はない（書くと gh api 等まで承認 1 回で使えるため、書かないことを勧める）
# GITHUB_REPOS=your-name/your-repo
