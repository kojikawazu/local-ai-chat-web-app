generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Conversation {
  id           String    @id @default(uuid())
  title        String
  systemPrompt String? // 会話の役割（システムプロンプト）。null は役割なし
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  metadata       Json?        // ツール呼び出し情報等 { toolCalls: ToolCallRecord[] }
  createdAt      DateTime     @default(now())
  attachments    Attachment[]
}

// メッセージの画像。user は添付した画像（#6）、assistant はブラウザのツールが撮った画面（#200）
model Attachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  position  Int // メッセージ内の並び順（0 始まり）。同じトランザクションで作ると createdAt が揃い、並べられないため
  mimeType  String // 中身（マジックナンバー）から判定した形式。クライアントの申告は使わない
  width     Int
  height    Int
  size      Int // バイト数
  data      Bytes
  createdAt DateTime @default(now())

  @@index([messageId])
}
